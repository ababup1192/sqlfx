///
/// 解決済みの `.q` から Flix のコードを吐く（PLAN フェーズ 2-3）。
/// 出すのは、クエリごとの行レコード・デコーダ・型付き関数と、テーブルごとの Col 定義。
///
/// WhyNot: テンプレートエンジンを使わず文字列連結なのは、出す形が固定で分岐が少ないから。
///
mod Codegen {

    use QueryDef.Segment
    use QueryDef.Shape
    use QueryDef.SlotKind
    use QueryDef.Query
    use QResolve.Resolved
    use QResolve.ResultColumn
    use Schema.Schema
    use Schema.Table
    use SqlType.SqlType

    ///
    /// 生成器のバージョン。出力の形が変わったら上げる。生成物に埋めて照合する。
    ///
    pub def version(): String = "5"

    pub enum CodegenError with Eq, Order, ToString {
        /// (クエリ名, 列名) 結果に同じ列名が 2 つある。AS で名前を変える
        case DuplicateResultColumn(String, String)
        /// (クエリ名, 名前) query 名・引数名・slot 名が Flix の予約語か、生成コードが内部で使う名前と衝突する
        case InvalidName(String, String)
        /// (テーブル名, 制約名) 制約名から Flix の case 名が作れない（数字始まり、記号）
        case InvalidConstraintName(String, String)
        /// (テーブル名, case 名) 2 つの制約名が同じ case 名になる（`users_email_key` と `email_key` など）
        case DuplicateConstraintCase(String, String)
    }

    ///
    /// `.q` の中身のハッシュ。生成物に埋め、テストと起動時に照合する。
    ///
    pub def sourceHash(source: String): Int32 = Hash.hash(source)

    ///
    /// ファイル名 `users.q` → モジュール名 `UsersQueries`。
    ///
    pub def moduleNameOf(fileName: String): String =
        String.splitOn(substr = ".", fileName) |> List.head |> Option.getWithDefault(fileName) |> pascalCase |> (stem -> stem + "Queries")

    ///
    /// テーブル名 `users` → モジュール名 `UsersTable`。
    ///
    pub def tableModuleOf(tableName: String): String = pascalCase(tableName) + "Table"

    // ---- クエリのモジュール ----

    ///
    /// 1 つの `.q` ファイルから 1 モジュール。`origin` はファイル名（モジュール名の元）と中身（ハッシュの元）。
    ///
    pub def renderQueries(origin: { fileName = String, source = String }, resolved: List[Resolved]): Result[CodegenError, String] =
        let fileName = origin#fileName;
        let source = origin#source;
        let moduleName = moduleNameOf(fileName);
        resolved
            |> List.traverse(renderQuery)
            |> Result.map(bodies ->
                List.join("\n", List#{
                    "// GENERATED by sqlfx gen v${version()} from ${fileName}. Do not edit.",
                    "mod ${moduleName} {",
                    "",
                    "    use SqlValue.SqlValue",
                    "    use Decoder.Decoder",
                    "",
                    "    ///",
                    "    /// 生成元 ${fileName} のハッシュ。テストで .q の現物と照合する。",
                    "    ///",
                    "    pub def sourceHash(): Int32 = ${sourceHash(source)}",
                    "",
                    List.join("\n", bodies),
                    "}",
                    ""
                }))

    ///
    /// 1 つの query から、行レコード + デコーダ + 関数。exec なら関数だけ。
    ///
    def renderQuery(resolved: Resolved): Result[CodegenError, String] =
        let queryDef = resolved#queryDef;
        forM (
            _ <- checkNames(queryDef);
            _ <- checkDuplicateColumns(queryDef#name, resolved#columns)
        ) yield match queryDef#shape {
            case Shape.Exec => renderFunction(resolved)
            case _ => List.join("\n", List#{renderRowType(resolved), renderDecoder(resolved), renderFunction(resolved)})
        }

    ///
    /// query 名・引数名・slot 名がそのまま Flix の識別子になるので、予約語と生成コードの内部名（sql / params / paramsN / xxxSql / sourceHash）を弾く。
    ///
    def checkNames(queryDef: Query): Result[CodegenError, Unit] =
        let names = queryDef#name :: List.append(List.map(param -> param#name, queryDef#params), List.map(slot -> slot#name, queryDef#slots));
        names
            |> List.find(name -> isReserved(name) or isInternalName(name))
            |> Option.map(name -> CodegenError.InvalidName(queryDef#name, name))
            |> (invalid -> match invalid { case Some(e) => Err(e) case None => Ok(()) })

    def isInternalName(name: String): Bool =
        name == "sql" or name == "sourceHash" or String.startsWith(prefix = "params", name) or String.endsWith(suffix = "Sql", name)

    def checkDuplicateColumns(queryName: String, columns: List[ResultColumn]): Result[CodegenError, Unit] =
        let names = List.map(column -> column#name, columns);
        match List.find(name -> List.count(other -> other == name, names) > 1, names) {
            case Some(name) => Err(CodegenError.DuplicateResultColumn(queryName, name))
            case None => Ok(())
        }

    def rowTypeName(queryDef: Query): String = pascalCase(queryDef#name) + "Row"

    ///
    /// `pub type alias FindUserRow = { id = Int64, name = String, role = Option[String] }`
    ///
    def renderRowType(resolved: Resolved): String =
        let fields = resolved#columns |> List.map(column -> "${fieldName(column#name)} = ${columnFlixType(column)}") |> List.join(", ");
        List.join("\n", List#{
            "    ///",
            "    /// ${resolved#queryDef#name} の 1 行。",
            "    ///",
            "    pub type alias ${rowTypeName(resolved#queryDef)} = { ${fields} }",
            ""
        })

    def columnFlixType(column: ResultColumn): String =
        if (column#nullable) "Option[${SqlType.toFlixType(column#columnType)}]" else SqlType.toFlixType(column#columnType)

    ///
    /// 列を forA で並べてレコードを組むデコーダ。列名と変数名が並ぶので、列の増減が 1 行で閉じる。
    ///
    def renderDecoder(resolved: Resolved): String =
        let fields = List.map(column -> fieldName(column#name), resolved#columns);
        let binds = resolved#columns |> List.map(column -> "            ${fieldName(column#name)} <- ${columnDecoder(column)}") |> List.join(";\n");
        let record = List.map(field -> "${field} = ${field}", fields) |> List.join(", ");
        List.join("\n", List#{
            "    def ${resolved#queryDef#name}Decoder(): Decoder[${rowTypeName(resolved#queryDef)}] =",
            "        forA (",
            binds,
            "        ) yield { ${record} }",
            ""
        })

    def columnDecoder(column: ResultColumn): String =
        let base = "${SqlType.decoderName(column#columnType)}(\"${column#name}\")";
        if (column#nullable) "Decoder.opt(${base})" else base

    ///
    /// 型付きの関数。引数は .q の宣言順、その後ろに slot。引数が 2 つ以上なら 1 つのレコードで受ける（呼ぶ側は `f(id = 1i64, name = "x")` と名前付きで書ける）。
    ///
    /// WhyNot: 位置引数で並べないのは、同じ型が並ぶと取り違えてもコンパイルが通るから。1 つだけなら名前を付ける意味が薄い。
    ///
    def renderFunction(resolved: Resolved): String =
        let queryDef = resolved#queryDef;
        let (sqlTemplate, orderedNames) = QRender.toSql(queryDef);
        let useRecord = List.length(queryDef#params) >= 2;
        let paramDecls =
            if (useRecord)
                List#{"args: { ${queryDef#params |> List.map(param -> "${param#name} = ${SqlType.toFlixType(param#paramType)}") |> List.join(", ")} }"}
            else
                queryDef#params |> List.map(param -> "${param#name}: ${SqlType.toFlixType(param#paramType)}");
        let slotDecls = queryDef#slots |> List.map(slot -> "${slot#name}: ${slotFlixType(slot#kind, slot#table)}");
        let signature = List.append(paramDecls, slotDecls) |> List.join(", ");
        let paramRef = name -> if (useRecord) "args#${name}" else name;
        let baseParams = orderedNames
            |> List.map(name -> queryDef#params |> List.find(param -> param#name == name) |> Option.map(param -> "${SqlType.sqlValueCase(param#paramType)}(${paramRef(param#name)})") |> Option.getWithDefault(""))
            |> (values -> if (List.isEmpty(values)) "Nil" else "List#{${List.join(", ", values)}}");
        let decoder = "${queryDef#name}Decoder()";
        let (resultType, effects, statement) = match (queryDef#shape, resolved#writes) {
            case (Shape.One, false) => ("Option[${rowTypeName(queryDef)}]", "DbRead", "Sql.fetchOneAs(${decoder}, sql, params)")
            case (Shape.Many, false) => ("List[${rowTypeName(queryDef)}]", "DbRead", "Sql.fetchAs(${decoder}, sql, params)")
            case (Shape.One, true) => ("Option[${rowTypeName(queryDef)}]", "DbWrite", "Sql.executeReturningOneAs(${decoder}, sql, params)")
            case (Shape.Many, true) => ("List[${rowTypeName(queryDef)}]", "DbWrite", "Sql.executeReturningAs(${decoder}, sql, params)")
            case (Shape.Exec, _) => ("Int32", "DbWrite", "Sql.execute(sql, params)")
        };
        // 生成器が検査した SQL なので、生成関数の中で RawSql を許可する。slot に入る Fragment.rawPred は呼び出し側で許可するので、ここでは覆われない
        let call = "RawSql.runWithAllow(() -> ${statement})";
        let doc = List.join("\n", List#{
            "    ///",
            "    /// ${queryDef#name}: ${oneLine(sqlTemplate)}",
            "    ///"
        });
        let header = "    pub def ${queryDef#name}(${signature}): ${resultType} \\ ${effects} =";
        let body =
            if (List.isEmpty(queryDef#slots))
                List#{
                    "        let sql = ${flixString(sqlTemplate)};",
                    "        let params = ${baseParams};",
                    "        ${call}"
                }
            else
                List.append(
                    "        let params0 = ${baseParams};" :: renderSlotLets(queryDef),
                    List#{
                        "        let sql = ${renderSqlConcat(queryDef)};",
                        "        let params = params${List.length(List.filter(slot -> consumesParams(slot#kind), queryDef#slots))};",
                        "        ${call}"
                    }) |> skipWhenNoChanges(queryDef);
        List.join("\n", List.append(doc :: header :: body, List#{""}))

    ///
    /// Changes の slot がどれか空なら、文を DB に出さずに 0 を返す形に本体を包む。
    /// 空の SET 句は構文エラーで、`SET updated_at = now(), {changes}` のように固定の代入と並べても壊れないようにするため。
    ///
    def skipWhenNoChanges(queryDef: Query, body: List[String]): List[String] =
        match List.filter(slot -> slot#kind == SlotKind.Changes, queryDef#slots) {
            case Nil => body
            case changesSlots =>
                let condition = changesSlots |> List.map(slot -> "Fragment.isEmptyChanges(${slot#name})") |> List.join(" or ");
                List.append(
                    "        if (${condition}) 0 else {" :: List.map(line -> "    " + line, body),
                    List#{"        }"})
        }

    ///
    /// `$n` の値を積む slot か。Order は SQL の文字列だけを出す。
    ///
    def consumesParams(kind: SlotKind): Bool = match kind {
        case SlotKind.Pred => true
        case SlotKind.Order => false
        case SlotKind.Changes => true
    }

    def slotFlixType(kind: SlotKind, table: String): String = match kind {
        case SlotKind.Pred => "Fragment.Pred[${tableModuleOf(table)}.${tableModuleOf(table)}]"
        case SlotKind.Order => "Fragment.Order[${tableModuleOf(table)}.${tableModuleOf(table)}]"
        case SlotKind.Changes => "Fragment.Changes[${tableModuleOf(table)}.${tableModuleOf(table)}]"
    }

    ///
    /// Pred の slot ごとに `let (filterSql, params1) = Fragment.appendPred(filter, params0);`、Changes は appendChanges、Order は `let orderSql = ...`。
    ///
    def renderSlotLets(queryDef: Query): List[String] =
        let (lines, _) = List.foldLeft((state, slot) -> {
            let (acc, paramSlotCount) = state;
            match slot#kind {
                case SlotKind.Pred =>
                    ("        let (${slot#name}Sql, params${paramSlotCount + 1}) = Fragment.appendPred(${slot#name}, params${paramSlotCount});" :: acc, paramSlotCount + 1)
                case SlotKind.Changes =>
                    ("        let (${slot#name}Sql, params${paramSlotCount + 1}) = Fragment.appendChanges(${slot#name}, params${paramSlotCount});" :: acc, paramSlotCount + 1)
                case SlotKind.Order =>
                    ("        let ${slot#name}Sql = Fragment.renderOrder(${slot#name});" :: acc, paramSlotCount)
            }
        }, (Nil, 0), queryDef#slots);
        List.reverse(lines)

    ///
    /// 本文を `"..." + filterSql + "..."` に組む。`:name` は `$n` に置く。
    ///
    def renderSqlConcat(queryDef: Query): String =
        let (_, orderedNames) = QRender.toSql(queryDef);
        queryDef#body
            |> List.map(segment -> match segment {
                case Segment.Text(text) => Ok(text)
                case Segment.ParamRef(name) => Ok("$${(List.indexOf(name, orderedNames) |> Option.getWithDefault(0)) + 1}")
                case Segment.SlotRef(name) => Err("${name}Sql")
            })
            |> mergeLiterals
            |> List.map(piece -> match piece { case Ok(literal) => flixString(literal) case Err(variable) => variable })
            |> List.join(" + ")

    ///
    /// 隣り合う文字列（Ok）を 1 つのリテラルにまとめる。変数（Err）はそのまま。
    ///
    def mergeLiterals(pieces: List[Result[String, String]]): List[Result[String, String]] =
        List.foldRight((piece, acc) -> match (piece, acc) {
            case (Ok(left), Ok(right) :: rest) => Ok(left + right) :: rest
            case _ => piece :: acc
        }, Nil, pieces)

    // ---- テーブルのモジュール ----

    ///
    /// スキーマの全テーブルから、断片 DSL 用の Col 定義を 1 ファイルに。
    ///
    pub def renderTables(schema: Schema): Result[CodegenError, String] =
        Map.valuesOf(schema)
            |> List.traverse(renderTable)
            |> Result.map(modules -> List.join("\n", List#{
                "// GENERATED by sqlfx gen v${version()} from migrations. Do not edit.",
                "",
                List.join("\n", modules)
            }))

    ///
    /// DDL の NOT NULL を `Col` の第 3 型パラメータに写す。
    ///
    def nullabilityMarker(nullable: Bool): String =
        if (nullable) "Fragment.Nullable" else "Fragment.NotNull"

    ///
    /// `mod UsersTable { pub enum UsersTable { case UsersTable }  pub def id(): Col[UsersTable, Int64, NotNull] = ... }`
    /// 型が分からない列は出さない。名前付きの制約があれば `Constraint` enum と `onConstraint` も出す。
    ///
    def renderTable(table: Table): Result[CodegenError, String] =
        let moduleName = tableModuleOf(table#name);
        let cols = table#columns
            |> List.filterMap(column -> column#columnType |> Option.map(sqlType ->
                "    pub def ${fieldName(column#name)}(): Fragment.Col[${moduleName}, ${SqlType.toFlixType(sqlType)}, ${nullabilityMarker(column#nullable)}] = Fragment.Col.Col(${flixString(column#name)}, ${SqlType.sqlValueCase(sqlType)})"));
        renderConstraints(table) |> Result.map(constraints -> List.join("\n", List#{
            "///",
            "/// ${table#name} テーブル。enum は断片 DSL の型に付ける印、関数は列。",
            "///",
            "mod ${moduleName} {",
            "",
            "    use SqlValue.SqlValue",
            "",
            "    pub enum ${moduleName} {",
            "        case ${moduleName}",
            "    }",
            "",
            List.join("\n", cols),
            constraints,
            "}",
            ""
        }))

    ///
    /// `pub enum Constraint { case EmailKey ... }` と、翻訳しながら書き込む `onConstraint`、違反を DbErr に戻す `raiseConstraint`。
    /// 制約が 1 つも無ければ何も出さない（Flix の enum は case が要る）。
    ///
    def renderConstraints(table: Table): Result[CodegenError, String] =
        if (List.isEmpty(table#constraints))
            Ok("")
        else
            forM (
                entries <- List.traverse(constraint -> constraintCase(table#name, constraint#name) |> Result.map(caseName -> (caseName, constraint)), table#constraints);
                _ <- checkDuplicateCases(table#name, List.map(fst, entries))
            ) yield {
                let cases = List.map(match (caseName, constraint) -> "        /// ${constraint#name} (${constraintKindWord(constraint#kind)})\n        case ${caseName}", entries);
                let ofName = List.map(match (caseName, constraint) -> "        case ${flixString(constraint#name)} => Some(Constraint.${caseName})", entries);
                let raises = List.map(match (caseName, constraint) -> "        case Constraint.${caseName} => ${raiseCall(constraint)}", entries);
                List.join("\n", List#{
                    "",
                    "    ///",
                    "    /// DDL の名前付き制約。違反の翻訳は `onConstraint` に渡す関数で書く。case が足りなければコンパイルエラー。",
                    "    ///",
                    "    pub enum Constraint with Eq, Order, ToString {",
                    List.join("\n", cases),
                    "    }",
                    "",
                    "    ///",
                    "    /// このテーブルへの書き込みを、制約違反を `translate` で翻訳しながら実行する。",
                    "    /// translate は thunk と同じ型の値を返すか、業務エラーのエフェクトを投げる。翻訳しない case は `raiseConstraint`。",
                    "    /// enum に無い名前の違反と、制約違反以外の DbErr はそのまま上へ。Tx の外で呼ぶ（違反で abort した Tx に COMMIT を出さない）。",
                    "    ///",
                    "    pub def onConstraint(translate: Constraint -> a \\ ef1, thunk: Unit -> a \\ ef2): a \\ ef1 + ef2 + {TransientDbErr, DbErr} =",
                    "        DbError.onConstraintWith(constraintOf, translate, thunk)",
                    "",
                    "    ///",
                    "    /// 翻訳しない制約を元の DbErr に戻す。`onConstraint` に渡す関数の中で使う。",
                    "    ///",
                    "    pub def raiseConstraint(constraint: Constraint): a \\ DbErr = match constraint {",
                    List.join("\n", raises),
                    "    }",
                    "",
                    "    def constraintOf(name: String): Option[Constraint] = match name {",
                    List.join("\n", ofName),
                    "        case _ => None",
                    "    }",
                    ""
                })
            }

    ///
    /// `users_email_key` → `EmailKey`（テーブル名の接頭辞を落として PascalCase）。接頭辞が無ければ全体を PascalCase。
    /// 英数字と `_` 以外を含む名前や、数字で始まる名前は case 名にできないのでエラー。
    ///
    pub def constraintCase(tableName: String, constraintName: String): Result[CodegenError, String] =
        let prefix = tableName + "_";
        let rest = if (String.startsWith(prefix = prefix, constraintName)) String.dropLeft(String.length(prefix), constraintName) else constraintName;
        let caseName = pascalCase(if (String.isEmpty(rest)) constraintName else rest);
        let valid = String.forAll(ch -> Char.isLetter(ch) or Char.isDigit(ch), caseName) and Option.exists(Char.isLetter, String.toList(caseName) |> List.head);
        if (valid) Ok(caseName) else Err(CodegenError.InvalidConstraintName(tableName, constraintName))

    def checkDuplicateCases(tableName: String, caseNames: List[String]): Result[CodegenError, Unit] =
        match List.find(name -> List.count(other -> other == name, caseNames) > 1, caseNames) {
            case Some(name) => Err(CodegenError.DuplicateConstraintCase(tableName, name))
            case None => Ok(())
        }

    def constraintKindWord(kind: Schema.ConstraintKind): String = match kind {
        case Schema.ConstraintKind.Unique => "unique"
        case Schema.ConstraintKind.ForeignKey => "foreign key"
        case Schema.ConstraintKind.Check => "check"
    }

    def raiseCall(constraint: Schema.Constraint): String = match constraint#kind {
        case Schema.ConstraintKind.Unique => "DbErr.uniqueViolation(${flixString(constraint#name)})"
        case Schema.ConstraintKind.ForeignKey => "DbErr.foreignKeyViolation(${flixString(constraint#name)})"
        case Schema.ConstraintKind.Check => "DbErr.checkViolation(${flixString(constraint#name)})"
    }

    // ---- 名前と文字列 ----

    ///
    /// `user_id` → `userId`。Flix の予約語なら末尾に `_` を付ける。
    ///
    pub def fieldName(columnName: String): String =
        let camel = String.splitOn(substr = "_", columnName)
            |> List.filter(part -> not String.isEmpty(part))
            |> List.mapWithIndex((index, part) -> if (index == 0) part else capitalize(part))
            |> List.join("");
        if (isReserved(camel)) camel + "_" else camel

    ///
    /// `search_users` → `SearchUsers`、`findUser` → `FindUser`。
    ///
    def pascalCase(name: String): String =
        String.splitOn(substr = "_", name) |> List.filter(part -> not String.isEmpty(part)) |> List.map(capitalize) |> List.join("")

    def capitalize(word: String): String =
        String.toUpperCase(String.takeLeft(1, word)) + String.dropLeft(1, word)

    ///
    /// docs/flix-conventions.md の予約語（レコードのフィールド名でも落ちる物）。
    ///
    def isReserved(word: String): Bool =
        List.memberOf(word, List#{
            "alias", "and", "as", "case", "catch", "choose", "def", "eff", "else", "enum", "false", "fix", "forA", "forM", "foreach",
            "from", "if", "import", "inline", "instance", "into", "law", "lawful", "lazy", "let", "match", "mod", "not", "null", "or",
            "override", "par", "pub", "query", "region", "run", "sealed", "select", "spawn", "static", "struct", "throw", "trait",
            "true", "try", "type", "typematch", "unsafe", "use", "where", "with", "without", "yield", "handler", "new", "force", "project", "solve", "inject"
        })

    ///
    /// Flix の文字列リテラルにする。改行は `\n`、`"` と `\` はエスケープ。
    ///
    def flixString(text: String): String =
        "\"" + (text
            |> String.replace(src = "\\", dst = "\\\\")
            |> String.replace(src = "\"", dst = "\\\"")
            |> String.replace(src = "\n", dst = "\\n")) + "\""

    ///
    /// doc コメント用に 1 行へ潰す。
    ///
    def oneLine(text: String): String =
        String.splitOn(substr = "\n", text) |> List.map(String.trim) |> List.filter(line -> not String.isEmpty(line)) |> List.join(" ")

}
