// Codegen: 生成コードの形。全文のスナップショットは examples/blog/src/Gen が兼ねる（make gen で再生成して差分を見る）。

/// 列名は camelCase に、予約語は末尾 `_`。
@Test
def testFieldName(): Unit \ Assert =
    Assert.assertEq(
        expected = List#{"userId", "name", "alias_", "type_", "createdAt"},
        List.map(Codegen.fieldName, List#{"user_id", "name", "alias", "type", "created_at"}))

/// ファイル名とテーブル名からモジュール名。
@Test
def testModuleNames(): Unit \ Assert =
    Assert.assertEq(
        expected = ("UsersQueries", "BlogPostsQueries", "UsersTable"),
        (Codegen.moduleNameOf("users.q"), Codegen.moduleNameOf("blog_posts.q"), Codegen.tableModuleOf("users")))

/// 1 つの query から出る関数の形（行レコード・デコーダ・関数・ハッシュ）。
@Test
def testRenderQueries(): Unit \ Assert =
    let source = "query findUser(id: Int64) -> one { SELECT id, email FROM users WHERE id = :id }";
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY, email TEXT)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let code = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "users.q", source = source }, resolved) |> Result.mapErr(ToString.toString));
    let expectedLines = List#{
        "// GENERATED by sqlfx gen v1 from users.q. Do not edit.",
        "mod UsersQueries {",
        "",
        "    use SqlValue.SqlValue",
        "    use Decoder.Decoder",
        "",
        "    ///",
        "    /// 生成元 users.q のハッシュ。テストで .q の現物と照合する。",
        "    ///",
        "    pub def sourceHash(): Int32 = ${Codegen.sourceHash(source)}",
        "",
        "    ///",
        "    /// findUser の 1 行。",
        "    ///",
        "    pub type alias FindUserRow = { id = Int64, email = Option[String] }",
        "",
        "    def findUserDecoder(): Decoder[FindUserRow] =",
        "        forA (",
        "            id <- Decoder.int64(\"id\");",
        "            email <- Decoder.opt(Decoder.str(\"email\"))",
        "        ) yield { id = id, email = email }",
        "",
        "    ///",
        "    /// findUser: SELECT id, email FROM users WHERE id = $1",
        "    ///",
        "    pub def findUser(id: Int64): Option[FindUserRow] \\ DbRead =",
        "        let sql = \"SELECT id, email FROM users WHERE id = $1\";",
        "        let params = List#{SqlValue.Int64(id)};",
        "        Sql.fetchOneAs(findUserDecoder(), sql, params)",
        "",
        "}",
        ""
    };
    Assert.assertEq(expected = Ok(List.join("\n", expectedLines)), code)

/// query 名・引数名・slot 名が予約語か内部名なら生成を止める。
@Test
def testInvalidNames(): Unit \ Assert =
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let errors = List#{
        "query f(type: String) -> exec { DELETE FROM users WHERE id = 1 AND 'x' = :type }",
        "query g(sql: String) -> exec { DELETE FROM users WHERE id = 1 AND 'x' = :sql }",
        "query params1() -> exec { DELETE FROM users }",
        "query h() -> many with filterSql: Pred[users] { SELECT id FROM users WHERE {filterSql} }"
    } |> List.map(source -> QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "x.q", source = source }, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(_ -> ()));
    Assert.assertEq(expected = List#{
        Err("InvalidName(f, type)"),
        Err("InvalidName(g, sql)"),
        Err("InvalidName(params1, params1)"),
        Err("InvalidName(h, filterSql)")
    }, errors)

/// RETURNING 付きの書き込みは SqlWrite + DbErr で行を返す関数になる。
@Test
def testRenderReturning(): Unit \ Assert =
    let source = "query addUser(name: String) -> one { INSERT INTO users (name) VALUES (:name) RETURNING id }";
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY, name TEXT)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let signature = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "users.q", source = source }, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line -> String.contains(substr = "pub def addUser", line) or String.contains(substr = "Sql.executeReturning", line)));
    Assert.assertEq(expected = Ok(List#{
        "    pub def addUser(name: String): Option[AddUserRow] \\ DbWrite =",
        "        Sql.executeReturningOneAs(addUserDecoder(), sql, params)"
    }), signature)

/// slot 付きの関数: Pred は続き番号の $n で本文に差し込まれ、Order は ORDER BY の文字列になる。
///
///   query q(limit: Int64) -> many with f: Pred[users], o: Order[users] { SELECT id FROM users WHERE {f} {o} LIMIT :limit }
@Test
def testRenderSlots(): Unit \ Assert =
    let source = "query q(limit: Int64) -> many with f: Pred[users], o: Order[users] { SELECT id FROM users WHERE {f} {o} LIMIT :limit }";
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let body = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "q.q", source = source }, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line -> String.startsWith(prefix = "        let ", line)));
    Assert.assertEq(expected = Ok(List#{
        "        let params0 = List#{SqlValue.Int64(limit)};",
        "        let (fSql, params1) = Fragment.appendPred(f, params0);",
        "        let oSql = Fragment.renderOrder(o);",
        "        let sql = \"SELECT id FROM users WHERE \" + fSql + \" \" + oSql + \" LIMIT $1\";",
        "        let params = params1;"
    }), body)
