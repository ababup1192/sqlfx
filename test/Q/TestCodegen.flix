// Codegen: 生成コードの形。全文のスナップショットは examples/blog/src/Gen が兼ねる（make gen で再生成して差分を見る）。

/// 列名は camelCase に、予約語は末尾 `_`。
@Test
def testFieldName(): Unit \ Assert =
    Assert.assertEq(
        expected = List#{"userId", "name", "alias_", "type_", "createdAt"},
        List.map(Codegen.fieldName, List#{"user_id", "name", "alias", "type", "created_at"}))

/// ファイル名とテーブル名からモジュール名。
@Test
def testModuleNames(): Unit \ Assert =
    Assert.assertEq(
        expected = ("UsersQueries", "BlogPostsQueries", "UsersTable"),
        (Codegen.moduleNameOf("users.q"), Codegen.moduleNameOf("blog_posts.q"), Codegen.tableModuleOf("users")))

/// 1 つの query から出る関数の形（行レコード・デコーダ・関数・ハッシュ）。
@Test
def testRenderQueries(): Unit \ Assert =
    let source = "query findUser(id: Int64) -> one { SELECT id, email FROM users WHERE id = :id }";
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY, email TEXT)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let code = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "users.q", source = source }, resolved) |> Result.mapErr(ToString.toString));
    let expectedLines = List#{
        "// GENERATED by sqlfx gen v9 from users.q. Do not edit.",
        "mod UsersQueries {",
        "",
        "    use SqlValue.SqlValue",
        "    use Decoder.Decoder",
        "",
        "    ///",
        "    /// Hash of the source users.q. `gen --check` compares it with the .q on disk.",
        "    ///",
        "    pub def sourceHash(): Int32 = ${Codegen.sourceHash(source)}",
        "",
        "    ///",
        "    /// One row of findUser.",
        "    ///",
        "    pub type alias FindUserRow = { id = Int64, email = Option[String] }",
        "",
        "    def findUserDecoder(): Decoder[FindUserRow] =",
        "        forA (",
        "            id <- Decoder.int64(\"id\");",
        "            email <- Decoder.opt(Decoder.str(\"email\"))",
        "        ) yield { id = id, email = email }",
        "",
        "    ///",
        "    /// findUser: SELECT id, email FROM users WHERE id = $1",
        "    ///",
        "    pub def findUser(id: Int64): Option[FindUserRow] \\ DbRead =",
        "        let sql = \"SELECT id, email FROM users WHERE id = $1\";",
        "        let params = List#{SqlValue.Int64(id)};",
        "        RawSql.runWithAllow(() -> Sql.fetchOneAs(findUserDecoder(), sql, params))",
        "",
        "}",
        ""
    };
    Assert.assertEq(expected = Ok(List.join("\n", expectedLines)), code)

/// NOT NULL の marker `!` の列は Option でない型と `Decoder.opt` 無しのデコーダになり、埋め込む SQL（slot 付きの連結も）から `!` は消える。
///
///   query a() -> one { SELECT count(*)::bigint! AS total FROM users }
///   query b() -> many with f: Pred[users] { SELECT count(*)::bigint! AS total, max(id)::bigint AS top FROM users WHERE {f} }
@Test
def testRenderNotNullMarker(): Unit \ Assert =
    let source = "query a() -> one { SELECT count(*)::bigint! AS total FROM users }\n"
        + "query b() -> many with f: Pred[users] { SELECT count(*)::bigint! AS total, max(id)::bigint AS top FROM users WHERE {f} }";
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let lines = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "users.q", source = source }, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line ->
            String.contains(substr = "Row =", line) or String.contains(substr = "<- Decoder", line) or String.contains(substr = "let sql", line) or String.startsWith(prefix = "    /// a:", line)));
    Assert.assertEq(expected = Ok(List#{
        "    pub type alias ARow = { total = Int64 }",
        "            total <- Decoder.int64(\"total\")",
        "    /// a: SELECT count(*)::bigint AS total FROM users",
        "        let sql = \"SELECT count(*)::bigint AS total FROM users\";",
        "    pub type alias BRow = { total = Int64, top = Option[Int64] }",
        "            total <- Decoder.int64(\"total\");",
        "            top <- Decoder.opt(Decoder.int64(\"top\"))",
        "        let sql = \"SELECT count(*)::bigint AS total, max(id)::bigint AS top FROM users WHERE \" + fSql;"
    }), lines)

/// 配列の引数: `List[Int32]` は SqlValue.Int32Array、`List[Json]` は SqlValue.ofJsonArray で包み、行型は List[...] になる。
///
///   query fill(ids: List[Int32], rows: List[Json]) -> many { SELECT v.n::int! AS n, v.d::jsonb! AS d FROM unnest(:ids, :rows) AS v(n, d) }
@Test
def testRenderArrayParams(): Unit \ Assert =
    let source = "query fill(ids: List[Int32], rows: List[Json]) -> many { SELECT v.n::int! AS n, v.d::jsonb! AS d FROM unnest(:ids, :rows) AS v(n, d) }";
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let lines = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "fill.q", source = source }, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line ->
            String.contains(substr = "Row =", line) or String.contains(substr = "<- Decoder", line) or String.startsWith(prefix = "    pub def fill", line) or String.contains(substr = "let params", line)));
    Assert.assertEq(expected = Ok(List#{
        "    pub type alias FillRow = { n = Int32, d = Util.Json.Json }",
        "            n <- Decoder.int32(\"n\");",
        "            d <- Decoder.json(\"d\")",
        "    pub def fill(args: { ids = List[Int32], rows = List[Util.Json.Json] }): List[FillRow] \\ DbRead =",
        "        let params = List#{SqlValue.Int32Array(args#ids), SqlValue.ofJsonArray(args#rows)};"
    }), lines)

/// query 名・引数名・slot 名が予約語か内部名なら生成を止める。
@Test
def testInvalidNames(): Unit \ Assert =
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let errors = List#{
        "query f(type: String) -> exec { DELETE FROM users WHERE id = 1 AND 'x' = :type }",
        "query g(sql: String) -> exec { DELETE FROM users WHERE id = 1 AND 'x' = :sql }",
        "query params1() -> exec { DELETE FROM users }",
        "query h() -> many with filterSql: Pred[users] { SELECT id FROM users WHERE {filterSql} }"
    } |> List.map(source -> QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "x.q", source = source }, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(_ -> ()));
    Assert.assertEq(expected = List#{
        Err("InvalidName(f, type)"),
        Err("InvalidName(g, sql)"),
        Err("InvalidName(params1, params1)"),
        Err("InvalidName(h, filterSql)")
    }, errors)

/// RETURNING 付きの書き込みは SqlWrite + DbErr で行を返す関数になる。
@Test
def testRenderReturning(): Unit \ Assert =
    let source = "query addUser(name: String) -> one { INSERT INTO users (name) VALUES (:name) RETURNING id }";
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY, name TEXT)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let signature = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "users.q", source = source }, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line -> String.contains(substr = "pub def addUser", line) or String.contains(substr = "RawSql.runWithAllow", line)));
    Assert.assertEq(expected = Ok(List#{
        "    pub def addUser(name: String): Option[AddUserRow] \\ DbWrite =",
        "        RawSql.runWithAllow(() -> Sql.executeReturningOneAs(addUserDecoder(), sql, params))"
    }), signature)

/// Option の引数: 関数は Option[T] を受け、None が型の付いた NULL になる（番兵の '' や 0 が要らない）。
///
///   query setRole(id: Int64, role: Option[String], expiresAt: Option[Timestamp]) -> exec
@Test
def testRenderOptionParams(): Unit \ Assert =
    let source = "query setRole(id: Int64, role: Option[String], expiresAt: Option[Timestamp]) -> exec "
        + "{ UPDATE users SET role = :role, expires_at = :expiresAt WHERE id = :id }";
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY, role TEXT, expires_at TIMESTAMPTZ)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let body = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "users.q", source = source }, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line -> String.startsWith(prefix = "    pub def setRole", line) or String.startsWith(prefix = "        let params", line)));
    Assert.assertEq(expected = Ok(List#{
        "    pub def setRole(args: { id = Int64, role = Option[String], expiresAt = Option[Timestamp.Timestamp] }): Int32 \\ DbWrite =",
        "        let params = List#{SqlValue.ofOption(SqlValue.NullType.Str, SqlValue.Str, args#role), "
            + "SqlValue.ofOption(SqlValue.NullType.Timestamp, SqlValue.ofTimestamp, args#expiresAt), SqlValue.Int64(args#id)};"
    }), body)

/// slot 付きの関数: Pred は続き番号の $n で本文に差し込まれ、Order は ORDER BY の文字列になる。
///
///   query q(limit: Int64) -> many with f: Pred[users], o: Order[users] { SELECT id FROM users WHERE {f} {o} LIMIT :limit }
@Test
def testRenderSlots(): Unit \ Assert =
    let source = "query q(limit: Int64) -> many with f: Pred[users], o: Order[users] { SELECT id FROM users WHERE {f} {o} LIMIT :limit }";
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let body = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "q.q", source = source }, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line -> String.startsWith(prefix = "        let ", line)));
    Assert.assertEq(expected = Ok(List#{
        "        let params0 = List#{SqlValue.Int64(limit)};",
        "        let (fSql, params1) = Fragment.appendPred(f, params0);",
        "        let oSql = Fragment.renderOrder(o);",
        "        let sql = \"SELECT id FROM users WHERE \" + fSql + \" \" + oSql + \" LIMIT $1\";",
        "        let params = params1;"
    }), body)

/// Changes の slot: appendChanges で続き番号を振り、空なら文を出さず 0 を返す形に包む。
///
///   query u(id: Int64) -> exec with c: Changes[users] { UPDATE users SET {c} WHERE id = :id }
@Test
def testRenderChangesSlot(): Unit \ Assert =
    let source = "query u(id: Int64) -> exec with c: Changes[users] { UPDATE users SET {c} WHERE id = :id }";
    let schema = DdlParser.apply("CREATE TABLE users (id BIGINT PRIMARY KEY)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let body = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "u.q", source = source }, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line -> String.startsWith(prefix = "    pub def u", line) or String.startsWith(prefix = "        ", line)));
    Assert.assertEq(expected = Ok(List#{
        "    pub def u(id: Int64, c: Fragment.Changes[UsersTable.UsersTable]): Int32 \\ DbWrite =",
        "        if (Fragment.isEmptyChanges(c)) 0 else {",
        "            let params0 = List#{SqlValue.Int64(id)};",
        "            let (cSql, params1) = Fragment.appendChanges(c, params0);",
        "            let sql = \"UPDATE users SET \" + cSql + \" WHERE id = $1\";",
        "            let params = params1;",
        "            RawSql.runWithAllow(() -> Sql.execute(sql, params))",
        "        }"
    }), body)

/// 意味を持つ型: Timestamp / Json の引数は SqlValue.ofTimestamp / ofJson で包み、行型と Col も同じ型になる。
///
///   query touch(id: Int64, at: Timestamp, meta: Json) -> one { UPDATE posts SET touched_at = :at, meta = :meta WHERE id = :id RETURNING touched_at, meta }
@Test
def testRenderSemanticTypes(): Unit \ Assert =
    let source = "query touch(id: Int64, at: Timestamp, meta: Json) -> one { UPDATE posts SET touched_at = :at, meta = :meta WHERE id = :id RETURNING touched_at, meta }";
    let schema = DdlParser.apply("CREATE TABLE posts (id BIGINT PRIMARY KEY, touched_at TIMESTAMPTZ NOT NULL, meta JSONB)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let queries = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(qs -> Result.traverse(QResolve.resolve(schema), qs) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueries({ fileName = "touch.q", source = source }, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line -> String.contains(substr = "TouchRow =", line) or String.contains(substr = "params =", line) or String.startsWith(prefix = "    pub def touch(", line)));
    let tables = Codegen.renderTables(schema)
        |> Result.mapErr(ToString.toString)
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line -> String.contains(substr = "def touchedAt", line)));
    Assert.assertEq(expected = (Ok(List#{
        "    pub type alias TouchRow = { touchedAt = Timestamp.Timestamp, meta = Option[Util.Json.Json] }",
        "    pub def touch(args: { id = Int64, at = Timestamp.Timestamp, meta = Util.Json.Json }): Option[TouchRow] \\ DbWrite =",
        "        let params = List#{SqlValue.ofTimestamp(args#at), SqlValue.ofJson(args#meta), SqlValue.Int64(args#id)};"
    }), Ok(List#{
        "    pub def touchedAt(): Fragment.Col[PostsTable, Timestamp.Timestamp, Fragment.NotNull] = Fragment.Col.Col(\"touched_at\", SqlValue.ofTimestamp)"
    })), (queries, tables))

/// 制約名 → case 名。テーブル名の接頭辞を落として PascalCase。数字始まりや記号はエラー、2 つの名前が同じ case になればエラー。
///
///   users_email_key → EmailKey / email_key → EmailKey（接頭辞無し）/ users_1_check → エラー / users_email_key + email_key → 重複
@Test
def testConstraintCase(): Unit \ Assert =
    let table = name -> { name = "users", columns = Nil, constraints = List.map(n -> { name = n, kind = Schema.ConstraintKind.Check }, name) };
    Assert.assertEq(
        expected = (Ok("EmailKey"), Ok("EmailKey"), Err(Codegen.CodegenError.InvalidConstraintName("users", "users_1_check")), Err(Codegen.CodegenError.DuplicateConstraintCase("users", "EmailKey"))),
        (Codegen.constraintCase("users", "users_email_key"),
         Codegen.constraintCase("users", "email_key"),
         Codegen.constraintCase("users", "users_1_check"),
         Codegen.renderTables(Schema.addTable(table(List#{"users_email_key", "email_key"}), Schema.empty())) |> Result.map(_ -> ())))

/// 注入する引数は署名から外れ、本文の先頭で effect から束ね、関数の effect に足される。
/// 残る引数の数でレコードか単独か引数無しかが決まる。slot 付きなら params0 の前に束ねる。
///
///   two(projectId, id, title) → record（id, title）/ one(projectId, id) → 単独（id）/ zero(projectId) → 引数無し / withSlot(projectId) + Pred
@Test
def testRenderInjectedParams(): Unit \ Assert =
    let source = "query two(projectId: Int64, id: Int64, title: String) -> exec { UPDATE entries SET title = :title WHERE id = :id AND project_id = :projectId }\n"
        + "query one(projectId: Int64, id: Int64) -> one { SELECT id FROM entries WHERE id = :id AND project_id = :projectId }\n"
        + "query zero(projectId: Int64) -> many { SELECT id FROM entries WHERE project_id = :projectId }\n"
        + "query withSlot(projectId: Int64) -> many with f: Pred[entries] { SELECT id FROM entries WHERE project_id = :projectId AND {f} }";
    let schema = DdlParser.apply("CREATE TABLE entries (id BIGINT PRIMARY KEY, project_id BIGINT NOT NULL, title TEXT NOT NULL)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let injection = { param = "projectId", effect = "Tenant" };
    let injections = Map#{"two" => List#{injection}, "one" => List#{injection}, "zero" => List#{injection}, "withSlot" => List#{injection}};
    let body = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueriesWith({ fileName = "entries.q", source = source }, injections, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line -> (String.startsWith(prefix = "    pub def ", line) and not String.contains(substr = "sourceHash", line)) or String.startsWith(prefix = "        let p", line)));
    Assert.assertEq(expected = Ok(List#{
        "    pub def two(args: { id = Int64, title = String }): Int32 \\ DbWrite + Tenant =",
        "        let projectId = Tenant.currentId();",
        "        let params = List#{SqlValue.Str(args#title), SqlValue.Int64(args#id), SqlValue.Int64(projectId)};",
        "    pub def one(id: Int64): Option[OneRow] \\ DbRead + Tenant =",
        "        let projectId = Tenant.currentId();",
        "        let params = List#{SqlValue.Int64(id), SqlValue.Int64(projectId)};",
        "    pub def zero(): List[ZeroRow] \\ DbRead + Tenant =",
        "        let projectId = Tenant.currentId();",
        "        let params = List#{SqlValue.Int64(projectId)};",
        "    pub def withSlot(f: Fragment.Pred[EntriesTable.EntriesTable]): List[WithSlotRow] \\ DbRead + Tenant =",
        "        let projectId = Tenant.currentId();",
        "        let params0 = List#{SqlValue.Int64(projectId)};",
        "        let params = params1;"
    }), body)

/// 2 つの scope の注入は宣言の順に束ね、effect も同じ順で並ぶ。effect の名前は名前空間付き（`Cms.Tenant`）でもそのまま埋まる。
@Test
def testRenderTwoInjections(): Unit \ Assert =
    let source = "query team(orgId: Int64, projectId: Int64) -> many { SELECT id FROM teams WHERE project_id = :projectId AND org_id = :orgId }";
    let schema = DdlParser.apply("CREATE TABLE teams (id BIGINT PRIMARY KEY, project_id BIGINT NOT NULL, org_id BIGINT NOT NULL)", Schema.empty()) |> Result.map(fst) |> Result.getWithDefault(Schema.empty());
    let injections = Map#{"team" => List#{{ param = "projectId", effect = "Cms.Tenant" }, { param = "orgId", effect = "Org" }}};
    let body = QParser.parseFile(source)
        |> Result.mapErr(ToString.toString)
        |> Result.flatMap(queries -> Result.traverse(QResolve.resolve(schema), queries) |> Result.mapErr(ToString.toString))
        |> Result.flatMap(resolved -> Codegen.renderQueriesWith({ fileName = "teams.q", source = source }, injections, resolved) |> Result.mapErr(ToString.toString))
        |> Result.map(code -> String.splitOn(substr = "\n", code) |> List.filter(line -> (String.startsWith(prefix = "    pub def ", line) and not String.contains(substr = "sourceHash", line)) or String.startsWith(prefix = "        let ", line)));
    Assert.assertEq(expected = Ok(List#{
        "    pub def team(): List[TeamRow] \\ DbRead + Cms.Tenant + Org =",
        "        let projectId = Cms.Tenant.currentId();",
        "        let orgId = Org.currentId();",
        "        let sql = \"SELECT id FROM teams WHERE project_id = $1 AND org_id = $2\";",
        "        let params = List#{SqlValue.Int64(projectId), SqlValue.Int64(orgId)};"
    }), body)
